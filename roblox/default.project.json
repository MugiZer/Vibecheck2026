{
  "name": "RiggedArcade",
  "tree": {
    "$className": "DataModel",
    "HttpService": { "$className": "HttpService", "$properties": { "HttpEnabled": true } },
    "Players": { "$className": "Players", "$properties": { "CharacterAutoLoads": false } },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true,
        "Ambient": [0.0706, 0.0627, 0.0549],
        "OutdoorAmbient": [0, 0, 0],
        "ClockTime": 0
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": { "Saturation": -0.2, "TintColor": [1, 0.9608, 0.8431], "Contrast": 0.05 }
      },
      "Bloom": { "$className": "BloomEffect", "$properties": { "Intensity": 0.5, "Size": 24, "Threshold": 1 } }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "CoordinatorUrl": { "$path": "CoordinatorUrl.txt" },
      "Art": { "$path": "art/models" }
    },
    "MaterialService": {
      "$className": "MaterialService",
      "Backrooms": { "$path": "art/materials" }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": { "$path": "src/shared" },
      "Coordinator": { "$className": "RemoteFunction" },
      "State": { "$className": "RemoteEvent" },
      "Log": { "$className": "RemoteEvent" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": { "$path": "src/client" }
      }
    }
  }
}
