{
  "name": "RiggedArcade",
  "tree": {
    "$className": "DataModel",
    "HttpService": { "$className": "HttpService", "$properties": { "HttpEnabled": true } },
    "Players": { "$className": "Players", "$properties": { "CharacterAutoLoads": false } },
    "ServerStorage": {
      "$className": "ServerStorage",
      "CoordinatorUrl": { "$path": "CoordinatorUrl.txt" },
      "Art": { "$path": "art/models" }
    },
    "MaterialService": {
      "$className": "MaterialService",
      "Backrooms": { "$path": "art/materials" }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": { "$path": "src/shared" },
      "Coordinator": { "$className": "RemoteFunction" },
      "State": { "$className": "RemoteEvent" },
      "Log": { "$className": "RemoteEvent" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": { "$path": "src/client" }
      }
    }
  }
}
